# OriginTrace AI - Environment Configuration
# The platform runs free-first without any API keys required for core functionality.
# Zero-key discovery engines: Openverse (CC catalog), Wayback Machine (CDX API), C2PA Provenance.

DEBUG=False
DATABASE_URL=sqlite:///./data/origintrace.db

# --- STORAGE & CACHE DIRECTORIES ---
UPLOADS_PATH=./data/uploads
THUMBNAILS_PATH=./data/thumbnails
CANDIDATES_PATH=./data/candidates
CACHE_PATH=./data/cache

# --- REVERSE IMAGE SEARCH (GOOGLE LENS VIA SERPAPI) ---
# Free plan includes 250 monthly searches (https://serpapi.com)
# Results are cached by SHA-256 to minimize credit consumption.
SERPAPI_API_KEY=

# --- ZERO-KEY FORENSIC & DISCOVERY CONNECTORS ---
# Openverse: Official public API (https://api.openverse.org/v1/images/) - No key required
# Wayback Machine: Internet Archive CDX API - No key required
# C2PA Verification: Local bitstream & JUMBF container parser - No key required

# --- OPTIONAL SOCIAL & SEARCH API KEYS ---
# YouTube Data API v3 (Free tier: 10,000 units/day)
YOUTUBE_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE=mastodon.social
SEARCH_API_KEY=

# --- OPTIONAL TOOL PATH OVERRIDES ---
# Tesseract OCR executable path (if not in system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract
FFMPEG_CMD=ffmpeg
