# OriginTrace AI - Environment Configuration Example
# The platform runs 100% free-first without any API keys required for core functionality.
# Optional keys expand search capabilities to restricted platforms.

DEBUG=False
DATABASE_URL=sqlite:///./data/origintrace.db

# --- OPTIONAL SOCIAL & SEARCH API KEYS ---
# YouTube Data API v3 key (optional developer quota)
YOUTUBE_API_KEY=

# Reddit OAuth Developer credentials (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bluesky credentials (optional - public read requires no credentials)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon Default Instance (defaults to mastodon.social)
MASTODON_INSTANCE=mastodon.social

# Custom Search API Key (optional)
SEARCH_API_KEY=

# --- OPTIONAL TOOL PATH OVERRIDES ---
# Tesseract OCR executable path (if not in system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# FFmpeg executable path (if not in system PATH)
FFMPEG_CMD=ffmpeg
